# Copia este archivo como ".env" y coloca los valores reales de tu proyecto Firebase.
# Estos SÍ pueden ir en el frontend (son públicos por diseño en Firebase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Estas NUNCA van en el frontend. Se configuran como variables de entorno
# en Netlify (Site settings -> Environment variables), no en este archivo:
#   GEMINI_API_KEY=... (consíguela gratis en https://aistudio.google.com/apikey)
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ... }
